# Using official Apache Hive prebuilt image to avoid slow Maven downloads
FROM apache/hive:4.0.0

USER root

# Download only the MySQL connector (much faster than building from scratch)
RUN curl -L https://repo1.maven.org/maven2/com/mysql/mysql-connector-j/8.0.33/mysql-connector-j-8.0.33.jar \
    -o /opt/hive/lib/mysql-connector-j-8.0.33.jar

# Copy configuration files
COPY metastore-site.xml /opt/hive/conf/
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Create hive user and set permissions
RUN groupadd -r hive --gid=1000 || true && \
    useradd -r -g hive --uid=1000 -d /opt/hive hive || true && \
    chown -R hive:hive /opt/hive /entrypoint.sh

USER hive
EXPOSE 9083

ENTRYPOINT ["/entrypoint.sh"]
